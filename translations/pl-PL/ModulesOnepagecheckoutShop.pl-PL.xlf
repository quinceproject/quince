<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en-US" target-language="pl-PL" datatype="plaintext" original="modules/ps_onepagecheckout">
    <body>
      <!-- Łata na błąd rdzenia: szablony modułu wołają domenę
           `Modules.Onepagecheckout.Shop` (bez „ps"), ale własny plik
           modułu nazywa się `ModulesPsonepagecheckoutShop...xlf` (z „ps")
           — te dwie nazwy nigdy się nie spotykają, więc tłumaczenie
           modułu nigdy się nie ładuje. Treść skopiowana jeden do jednego
           z `modules/ps_onepagecheckout/translations/pl-PL/
           ModulesPsonepagecheckoutShop.pl-PL.xlf`, tylko pod poprawną
           (zgadzającą się z szablonami) nazwą pliku. Sprawdzone bezpośrednio
           przez Translator: bez tego pliku `trans('Contact information', [],
           'Modules.Onepagecheckout.Shop')` zwracał nieprzetłumaczony
           angielski napis; z nim — „Dane kontaktowe". -->
      <trans-unit id="psopc.shop.account_connected_as">
        <source>Connected as [1]%firstname% %lastname%[/1].</source>
        <target>Zalogowano jako [1]%firstname% %lastname%[/1].</target>
      </trans-unit>
      <trans-unit id="psopc.shop.account_my_account_aria">
        <source>My account (%firstname% %lastname%)</source>
        <target>Moje konto (%firstname% %lastname%)</target>
      </trans-unit>
      <trans-unit id="psopc.shop.account_not_you_sign_out">
        <source>Not you? [1]Sign out[/1]</source>
        <target>To nie Ty? [1]Wyloguj się[/1]</target>
      </trans-unit>
      <trans-unit id="psopc.shop.already_have_account_sign_in">
        <source>Already have an account? Sign in</source>
        <target>Masz już konto? Zaloguj się</target>
      </trans-unit>
      <trans-unit id="psopc.shop.an_error_occurred_try_again">
        <source>An error occurred. Please try again.</source>
        <target>Wystąpił błąd. Spróbuj ponownie.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.an_error_loading_carriers">
        <source>An error occurred while loading carriers. Please try again.</source>
        <target>Wystąpił błąd podczas ładowania przewoźników. Spróbuj ponownie.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.an_error_loading_payment_methods">
        <source>An error occurred while loading payment methods. Please try again.</source>
        <target>Wystąpił błąd podczas ładowania metod płatności. Spróbuj ponownie.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.billing_address">
        <source>Billing address</source>
        <target>Adres rozliczeniowy</target>
      </trans-unit>
      <trans-unit id="psopc.shop.contact_information">
        <source>Contact information</source>
        <target>Dane kontaktowe</target>
      </trans-unit>
      <trans-unit id="psopc.shop.continue_as_guest">
        <source>Continue as guest</source>
        <target>Kontynuuj jako gość</target>
      </trans-unit>
      <trans-unit id="psopc.shop.create_account">
        <source>Create account</source>
        <target>Utwórz konto</target>
      </trans-unit>
      <trans-unit id="psopc.shop.delivery_address">
        <source>Delivery address</source>
        <target>Adres dostawy</target>
      </trans-unit>
      <trans-unit id="psopc.shop.delivery_method">
        <source>Delivery method</source>
        <target>Metoda dostawy</target>
      </trans-unit>
      <trans-unit id="psopc.shop.gift_note_prompt">
        <source>If you'd like, you can add a note to the gift:</source>
        <target>Jeśli chcesz, możesz dodać wiadomość do prezentu:</target>
      </trans-unit>
      <trans-unit id="psopc.shop.cart_emptied_on_sign_out">
        <source>If you sign out now, your cart will be emptied.</source>
        <target>Jeśli wylogujesz się teraz, Twój koszyk zostanie opróżniony.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.recycled_packaging">
        <source>I would like to receive my order in recycled packaging.</source>
        <target>Chcę otrzymać zamówienie w opakowaniu z recyklingu.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.loading_delivery_methods">
        <source>Loading delivery methods...</source>
        <target>Ładowanie metod dostawy...</target>
      </trans-unit>
      <trans-unit id="psopc.shop.loading_ellipsis">
        <source>Loading...</source>
        <target>Ładowanie...</target>
      </trans-unit>
      <trans-unit id="psopc.shop.loading_payment_methods">
        <source>Loading payment methods...</source>
        <target>Ładowanie metod płatności...</target>
      </trans-unit>
      <trans-unit id="psopc.shop.no_carriers_for_address">
        <source>Unfortunately, there are no carriers available for your delivery address.</source>
        <target>Niestety, nie ma dostępnych przewoźników dla Twojego adresu dostawy.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.no_payment_method_available">
        <source>Unfortunately, there are no payment method available.</source>
        <target>Niestety, nie ma dostępnej metody płatności.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.pay">
        <source>Pay</source>
        <target>Zapłać</target>
      </trans-unit>
      <trans-unit id="psopc.shop.payment_method">
        <source>Payment method</source>
        <target>Metoda płatności</target>
      </trans-unit>
      <trans-unit id="psopc.shop.proceed_to_checkout">
        <source>Proceed to checkout</source>
        <target>Przejdź do kasy</target>
      </trans-unit>
      <trans-unit id="psopc.shop.retry">
        <source>Retry</source>
        <target>Ponów</target>
      </trans-unit>
      <trans-unit id="psopc.shop.use_address_for_invoice_too">
        <source>Use this address for invoice too</source>
        <target>Użyj tego adresu również do faktury</target>
      </trans-unit>
      <trans-unit id="psopc.shop.delivery_methods_after_address">
        <source>You will see the available delivery methods once you've entered your delivery address.</source>
        <target>Zobaczysz dostępne metody dostawy po wpisaniu adresu dostawy.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.payment_methods_after_address">
        <source>You will see the available payment methods once you've entered your delivery address.</source>
        <target>Zobaczysz dostępne metody płatności po wpisaniu adresu dostawy.</target>
      </trans-unit>
      <trans-unit id="psopc.shop.order_comment_label">
        <source>Write a comment about this order</source>
        <target>Napisz komentarz do tego zamówienia</target>
      </trans-unit>
      <trans-unit id="psopc.shop.order_comment_placeholder">
        <source>Write your comment...</source>
        <target>Napisz swój komentarz...</target>
      </trans-unit>
      <trans-unit id="quince.1412f7dcbcbe" resname="Address details:">
        <source>Address details:</source>
        <target>Dane adresowe:</target>
      </trans-unit>
      <trans-unit id="quince.0f2128487e1f" resname="An error occurred while loading addresses. Please try again.">
        <source>An error occurred while loading addresses. Please try again.</source>
        <target>Nie udało się wczytać adresów. Spróbuj ponownie.</target>
      </trans-unit>
      <trans-unit id="quince.cae1b369089f" resname="Are you sure you want to delete this address?">
        <source>Are you sure you want to delete this address?</source>
        <target>Na pewno usunąć ten adres?</target>
      </trans-unit>
      <trans-unit id="quince.0f1556b1cbbb" resname="Delete this address?">
        <source>Delete this address?</source>
        <target>Usunąć ten adres?</target>
      </trans-unit>
      <trans-unit id="quince.0cbf677caf42" resname="Edit billing address">
        <source>Edit billing address</source>
        <target>Edytuj adres do faktury</target>
      </trans-unit>
      <trans-unit id="quince.8e1572c93c61" resname="Edit delivery address">
        <source>Edit delivery address</source>
        <target>Edytuj adres dostawy</target>
      </trans-unit>
      <trans-unit id="quince.9a1e1ced2c95" resname="Loading addresses...">
        <source>Loading addresses...</source>
        <target>Wczytywanie adresów...</target>
      </trans-unit>
      <trans-unit id="quince.8cad959f414b" resname="New billing address">
        <source>New billing address</source>
        <target>Nowy adres do faktury</target>
      </trans-unit>
      <trans-unit id="quince.32c2d21acbef" resname="New delivery address">
        <source>New delivery address</source>
        <target>Nowy adres dostawy</target>
      </trans-unit>
      <trans-unit id="quince.f1e8f49d1d8d" resname="Select address: %alias%">
        <source>Select address: %alias%</source>
        <target>Wybierz adres: %alias%</target>
      </trans-unit>
      <trans-unit id="quince.beb82bccc349" resname="This action will remove the selected address from your checkout.">
        <source>This action will remove the selected address from your checkout.</source>
        <target>Wybrany adres zostanie usunięty z zamówienia.</target>
      </trans-unit>
      <trans-unit id="quince.0c7789282e40" resname="Use a different delivery address">
        <source>Use a different delivery address</source>
        <target>Użyj innego adresu dostawy</target>
      </trans-unit>
    </body>
